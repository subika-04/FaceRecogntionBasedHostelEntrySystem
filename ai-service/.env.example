# Copy this file to `.env` in the same folder and fill in real values.
# `python-dotenv` / your process manager should load this before `run.py`/`wsgi.py` starts.

# ---- Networking ----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
FLASK_ENV=production
FLASK_DEBUG=false

# ---- Security ----
# MUST exactly match FLASK_API_KEY in the Spring Boot backend's .env.
# Generate with: openssl rand -hex 32
FLASK_API_KEY=change-me-to-a-real-shared-secret

# Only needed if you call this service directly from a browser during dev.
AI_CORS_ORIGINS=

# ---- Rate limiting ----
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_DEFAULT=120 per minute

# ---- Model (InsightFace) ----
AI_MODEL_NAME=buffalo_l
AI_MODEL_ROOT=/root/.insightface
AI_CTX_ID=-1
AI_DETECTION_SIZE=640
AI_MIN_DETECTION_SCORE=0.55

# ---- Quality gate thresholds (enrollment) ----
AI_MIN_FACE_AREA_RATIO=0.06
AI_MAX_FACE_AREA_RATIO=0.85
AI_BLUR_VARIANCE_THRESHOLD=60.0
AI_MIN_BRIGHTNESS=40.0
AI_MAX_BRIGHTNESS=215.0
AI_MAX_CENTER_OFFSET_RATIO=0.22
AI_MAX_YAW_DEGREES=35.0
AI_MAX_ROLL_DEGREES=25.0

# ---- Recognition ----
AI_EMBEDDING_DIM=512

# ---- Logging ----
AI_LOG_LEVEL=INFO
AI_LOG_DIR=./logs
AI_LOG_TO_FILE=true
