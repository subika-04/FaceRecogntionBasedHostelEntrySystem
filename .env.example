# Used by docker-compose.yml at the repository root.
# Copy to `.env` in this same folder before running `docker compose up`.

DB_NAME=frhes
DB_USER=frhes_app
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-different-strong-password

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret

# Generate with: openssl rand -hex 32
# MUST be identical here and in ai-service/.env's FLASK_API_KEY.
FLASK_API_KEY=change-me-shared-secret

AI_MODEL_NAME=buffalo_l
AI_CTX_ID=-1

# The URL your browser will use to reach the backend; only change this if
# you're deploying behind a real domain/reverse proxy instead of localhost.
FRONTEND_API_BASE_URL=http://localhost:8080/api/v1

# One-time bootstrap admin account, created automatically on the backend's
# first startup only (when the users table is completely empty). Leave
# BOOTSTRAP_ADMIN_PASSWORD unset to skip this and create your first admin
# some other way. Password must satisfy the MEDIUM password policy: 8+
# characters, at least one letter and one digit.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
